{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "velo-react-project",
          "format": "url",
          "env": "VELO_PROJECT_URL"
        }
      ]
    },
    "velo-react-project": {
      "root": "velo-react-project",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
